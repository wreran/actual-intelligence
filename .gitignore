# Virtual environment
.venv/
__pycache__/
*.pyc

# Competition data — ~330 MB, redownload from Kaggle rather than commit.
# See README.md for the layout the scripts expect.
data/
*.csv.zip
train_features.csv
test_features.csv
train.csv
test.csv
